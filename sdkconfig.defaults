# Flash — P4 has 16MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# esp_hosted core
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_HOSTED_ENABLED=y

# SDIO transport
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y

# Board: custom (CrowPanel, not Espressif EV board)
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y

# SDIO Slot 1 via GPIO matrix
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y

# 1-bit bus (proven stable on CrowPanel)
CONFIG_ESP_HOSTED_SDIO_1_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=1

# Conservative 10 MHz clock for OTA reliability
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=10000

# CrowPanel SDIO pins. CLK and CMD are the same on every revision.
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
# Data and reset lines differ by PCB revision and main.c sets all three at
# runtime before the transport starts, so these are only the values a build
# would fall back to. They name V1.1, which is what main.c tries first.
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=17
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_1BIT_BUS_SLOT_1=16

# Reset, active high (R77 pullup on CrowPanel). GPIO54 on V1.1, GPIO32 on V1.0.
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54

# Delay after C6 reset to allow boot (v2.3.0 may be slow)
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=1500

# No RX optimization. Streaming mode needs a slave that speaks it, and this app
# exists to talk to whatever C6 firmware a board shipped with. When the host
# asks for streaming and the slave cannot answer, the SDIO card enumerates and
# the data path opens and then the slave never reports ready -- the same
# silence a wrong data-line map produces, which is what made these two so hard
# to tell apart.
#
# This line was inert until the esp_hosted bump to v2.11.6: v2.9.7 had no such
# option, so the first working run against a factory board was never actually
# in streaming mode. There is no throughput argument either way -- the transfer
# is ~1.1 MB once, and read speed is not what makes this slow.
#
# Keep it on packet regardless, because the two mismatches are not equally
# diagnosable and this is the good one. Packet host against the streaming slave
# an upgrade leaves behind aborts in process_init_event, loudly and after the
# slave has identified itself; streaming host against a factory slave just goes
# quiet, which is indistinguishable from the wrong data-line map. main.c reads
# that abort as proof the C6 is already upgraded, so choosing the failure that
# can be recognised is what lets one binary report on either state.
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_NONE=y

# Reset slave on host boot for clean state
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y

# OTA method: LittleFS
CONFIG_OTA_METHOD_LITTLEFS=y

# Skip version check — we force OTA regardless
# CONFIG_OTA_VERSION_CHECK_HOST_SLAVE is not set
# CONFIG_OTA_VERSION_CHECK_SLAVEFW_SLAVE is not set

# Watchdog: 15s (matches ESPHome config)
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Logger: verbose for experiment
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
